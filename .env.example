# --- Platforms (enable at least one) ---
TELEGRAM_TOKEN=
# Matrix homeserver (PDC)
MATRIX_HOMESERVER=https://matrix.privacydatacoin.com
MATRIX_USER=@pdctipbot:privacydatacoin.com
# Bootstrap: set MATRIX_PASSWORD (then restart). Prefer later MATRIX_ACCESS_TOKEN + MATRIX_DEVICE_ID.
MATRIX_ACCESS_TOKEN=
MATRIX_PASSWORD=
MATRIX_DEVICE_ID=
# Optional: restrict commands to these rooms (comma-separated room IDs). Empty = all joined rooms.
MATRIX_ALLOWED_ROOMS=
# Command prefixes on Matrix (comma-separated)
MATRIX_COMMAND_PREFIXES=!,/

# --- Ledger / storage ---
DATABASE_PATH=data/tipbot.db
MATRIX_STORE_PATH=data/matrix_store

# --- PDC wallet RPC (simplewallet --rpc-bind-*) ---
# Leave empty to run in dry-run mode (ledger only, no chain I/O)
# Production tipbot wallet often binds 19225; leave empty for dry-run
WALLET_RPC_URL=http://127.0.0.1:19225/json_rpc
WALLET_RPC_USER=
WALLET_RPC_PASSWORD=
DAEMON_RPC_URL=http://127.0.0.1:19211
# Native PDC asset id (mainnet). Override if your fork differs.
PDC_ASSET_ID=d6329b5b1f7c0805b5c345f4957554002a2f557845f64d7645dae0e051a6498a
# Fee in atomic units (default 0.01 PDC)
TRANSFER_FEE_ATOMIC=10000000000
# Confirmations before crediting deposits
DEPOSIT_MIN_CONFIRMATIONS=10
DEPOSIT_SCAN_INTERVAL_SEC=30

# --- Policy ---
MIN_TIP_ATOMIC=1000000000
MIN_WITHDRAW_ATOMIC=10000000000
DAILY_WITHDRAW_LIMIT_ATOMIC=50000000000000
EXPLORER_TX_URL=https://explorer.privacydatacoin.com/transaction/
BOT_DISPLAY_NAME=PDC TipBot
# Public hot-wallet alias (informational; deposits use integrated addresses)
HOT_WALLET_ALIAS=pdctipbot
# Hidden /totalbalance — Telegram usernames (comma-separated, no @)
ADMIN_TELEGRAM_USERNAMES=
# Optional Matrix MXIDs for the same command (full @user:server)
ADMIN_MATRIX_USER_IDS=

# --- /rain communal faucet ---
RAIN_ENABLED=1
# Public chat/room ids (not secrets). Leave empty until you set allowlists.
RAIN_TELEGRAM_CHAT_IDS=
RAIN_MATRIX_ROOM_IDS=
RAIN_TARGET_CLAIMS_PER_DAY=10
# 0.1 PDC min, 1 PDC max (atomic = * 10^12)
RAIN_CLAIM_MIN_ATOMIC=100000000000
RAIN_CLAIM_MAX_ATOMIC=1000000000000
RAIN_COOLDOWN_SEC=86400
